# Dependencies
node_modules/

# Gatsby build output
.cache/
public/

# Local tooling and workspace files
.claude/
.gsd/
.impeccable/
.bg-shell/
.vscode/
.mcp.json

# Internal docs (brand book, strategy) - not for the public repo
/docs/

# Local scratch
test.html

# OS
.DS_Store

# .env.development is tracked ON PURPOSE: it holds only GATSBY_ values, which
# are compiled into the bundle and public by definition. Every other env file
# is not -- there were no env rules here at all, so a stray .env holding a real
# secret would have been one `git add -A` away from the history.
.env
.env.local
.env.production
.env.*.local
.env.*.bak

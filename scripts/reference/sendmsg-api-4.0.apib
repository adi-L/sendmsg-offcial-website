                 "MessageInnerName":"inner name",
                 "SenderEmailAddress":"comstar@comstar.co.il",
                 "MessageBackColor": "black",
                 "MessageDirection":1,
                 "AddFacebook": true,
                 "AddForward": true,
                 "AddShowMessage":true
                }


+ Response 200 (application/json)

    + Body
    
                            {
                             "success": true-Or-false,
